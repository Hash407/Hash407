def astar(start, goal):
    pq = PriorityQueue()
    pq.put((0,start))

    cost = {start:0}

    while not pq.empty():
        _, node = pq.get()

        if node == goal:
            print("Goal Found")
            return

        for neighbor,w in graph[node]:
            new_cost = cost[node] + w

            if neighbor not in cost or new_cost < cost[neighbor]:
                cost[neighbor] = new_cost

                priority = new_cost + heuristic[neighbor]

                pq.put((priority,neighbor))

                print(node,"->",neighbor)

