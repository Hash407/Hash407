def dfs(state, goal, visited):
    if state == goal:
        print("Goal Found:", state)
        return True

    visited.add(state)

    x, y = state

    next_states = [
        (4, y),      # Fill Jug A
        (x, 3),      # Fill Jug B
        (0, y),      # Empty Jug A
        (x, 0),      # Empty Jug B
        (max(0, x-(3-y)), min(3, y+x)),  # Pour A->B
        (min(4, x+y), max(0, y-(4-x)))   # Pour B->A
    ]

    for new_state in next_states:
        if new_state not in visited:
            print("Visiting:", new_state)
            if dfs(new_state, goal, visited):
                return True

    return False

