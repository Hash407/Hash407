graph = {
    'A': [['B','C'], ['D']],
    'B': [['E']],
    'C': [['F']],
    'D': [],
    'E': [],
    'F': []
}

heuristic = {
    'A': 5,
    'B': 2,
    'C': 2,
    'D': 3,
    'E': 0,
    'F': 0
}

def ao_star(node):
    print("Expanding:", node)

    if not graph[node]:
        return heuristic[node]

    min_cost = float('inf')

    for path in graph[node]:

        cost = sum(ao_star(n) for n in path)

        min_cost = min(min_cost, cost)

    heuristic[node] = min_cost

    return min_cost

print("Optimal Cost:", ao_star('A'))








