9th (Selection Sort n>5000)

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void sort(int a[],int n){
    for(int i=0;i<n-1;i++){
        int m=i;
        for(int j=i+1;j<n;j++)
            if(a[j]<a[m]) m=j;
        int t=a[i]; a[i]=a[m]; a[m]=t;
    }
}

int main(){
    int n;
    printf("Enter n: ");
    scanf("%d",&n);

    int *a=malloc(n*sizeof(int));
    for(int i=0;i<n;i++) a[i]=rand()%10000;

    clock_t s=clock();
    sort(a,n);
    clock_t e=clock();

    printf("Time = %f seconds\n",(double)(e-s)/CLOCKS_PER_SEC);

    free(a);
    return 0;
}

