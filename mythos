12th (N Queen’s)



#include <stdio.h>
#include <stdlib.h>

int x[10], n;

int place(int k, int i) {
    for (int j = 1; j < k; j++)
        if (x[j] == i || abs(x[j] - i) == abs(j - k))
            return 0;
    return 1;
}

int queen(int k) {
    for (int i = 1; i <= n; i++) {
        if (place(k, i)) {
            x[k] = i;
            if (k == n) {
                for (int r = 1; r <= n; r++) {
                    for (int c = 1; c <= n; c++)
                        printf(x[r] == c ? "Q " : "# ");
                    printf("\n");
                }
                return 1;
            }
            if (queen(k + 1))
                return 1;
        }
    }
    return 0;
}

int main() {
    printf("Enter N: ");
    scanf("%d", &n);

    if (!queen(1))
        printf("No solution");

    return 0;
}


