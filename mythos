11th (Merge Sort n>5000)

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void merge(int a[], int l, int m, int r){
    int i=l,j=m+1,k=0,t[100000];
    while(i<=m&&j<=r) t[k++]=a[i]<a[j]?a[i++]:a[j++];
    while(i<=m) t[k++]=a[i++];
    while(j<=r) t[k++]=a[j++];
    for(i=l,k=0;i<=r;i++,k++) a[i]=t[k];
}

void sort(int a[], int l, int r){
    if(l<r){
        int m=(l+r)/2;
        sort(a,l,m);
        sort(a,m+1,r);
        merge(a,l,m,r);
    }
}

int main(){
    int n;
    printf("Enter n (>5000): ");
    scanf("%d",&n);

    int *a=malloc(n*sizeof(int));
    for(int i=0;i<n;i++) a[i]=rand()%100000;

    clock_t s=clock();
    sort(a,0,n-1);
    clock_t e=clock();

    printf("Time = %f seconds\n",(double)(e-s)/CLOCKS_PER_SEC);

    free(a);
    return 0;
}

