10TH (Quick Sort n>5000)

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void swap(int *a,int *b){int t=*a;*a=*b;*b=t;}

int part(int a[],int l,int h){
    int p=a[h],i=l-1;
    for(int j=l;j<h;j++)
        if(a[j]<p) swap(&a[++i],&a[j]);
    swap(&a[i+1],&a[h]);
    return i+1;
}

void quick(int a[],int l,int h){
    if(l<h){
        int p=part(a,l,h);
        quick(a,l,p-1);
        quick(a,p+1,h);
    }
}

int main(){
    int n;
    printf("Enter n: ");
    scanf("%d",&n);

    int *a=malloc(n*sizeof(int));
    for(int i=0;i<n;i++) a[i]=rand()%100000;

    clock_t s=clock();
    quick(a,0,n-1);
    clock_t e=clock();

    printf("Time = %f seconds\n",(double)(e-s)/CLOCKS_PER_SEC);

    free(a);
    return 0;
}

