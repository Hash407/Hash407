7th( Knapsack)

#include <stdio.h>

int main() {
    int n,m,w[50],p[50],i,j;
    float r[50],x[50],profit=0;

    printf("Enter n: ");
    scanf("%d",&n);

    printf("Enter weights: ");
    for(i=0;i<n;i++) scanf("%d",&w[i]);

    printf("Enter profits: ");
    for(i=0;i<n;i++) scanf("%d",&p[i]);

    printf("Enter capacity: ");
    scanf("%d",&m);

    for(i=0;i<n;i++) r[i]=(float)p[i]/w[i];

    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(r[i]<r[j]){
                float t=r[i]; r[i]=r[j]; r[j]=t;
                int k=w[i]; w[i]=w[j]; w[j]=k;
                k=p[i]; p[i]=p[j]; p[j]=k;
            }

    int cw=0;
    for(i=0;i<n;i++){
        if(cw+w[i]<=m){
            x[i]=1;
            cw+=w[i];
            profit+=p[i];
        }else{
            x[i]=(float)(m-cw)/w[i];
            profit+=x[i]*p[i];
            break;
        }
    }

    printf("Max Profit = %.2f\n",profit);
    return 0;
}

